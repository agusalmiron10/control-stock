{
  // Worker dedicado SOLO a la landing pública (chaupapel.com).
  //
  // Por qué un Worker y no Cloudflare Pages: adjuntar un dominio propio a un
  // proyecto de Pages por API deja el dominio en "pending" hasta que exista el
  // CNAME, y crear registros DNS necesita permiso de escritura sobre la zona
  // que el token OAuth de wrangler no tiene (sólo "zone (read)"). La API de
  // dominios de Workers, en cambio, crea el registro DNS ella misma. Mismo
  // resultado para el visitante: HTML estático servido desde el borde.
  //
  // Es un Worker APARTE del de la app (Worker "stockeate", en app.chaupapel.com), a
  // propósito: la landing no comparte nada con el sistema — ni base, ni
  // sesión, ni secrets. Si se cae una, la otra sigue.
  //
  // Sin "main": es un Worker de sólo assets, no hay código que ejecutar.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chaupapel-landing",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./landing"
  }
}
