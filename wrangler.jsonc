{
  // Configuración del Worker de Cloudflare para la app.
  //
  // OJO: la marca es ChauPapel (chaupapel.com), pero este Worker se sigue
  // llamando "stockeate" a propósito. El nombre del Worker es infraestructura
  // interna, invisible para el usuario, y renombrarlo NO es gratis: Cloudflare
  // no tiene "renombrar", así que crearía un Worker NUEVO y vacío — sin los
  // secrets cargados (SESSION_SECRET, RESEND_API_KEY, ...) y sin el dominio
  // app.chaupapel.com, que hoy apunta al servicio "stockeate". La app quedaría
  // caída hasta recargar todo eso a mano. Si algún día se hace, el orden es:
  // desplegar el nuevo, cargarle los secrets, mover el dominio, verificar, y
  // recién ahí borrar el viejo.
  //
  // Se renombró desde "control-stock" (nombre interno viejo, previo a la
  // marca). Cloudflare no tiene "renombrar" un Worker por CLI: cambiar este
  // campo y desplegar crea un Worker NUEVO y separado, con su propia URL
  // *.workers.dev y sus propios secrets — no se puede simplemente pisar el
  // nombre del que ya corría. El Worker viejo "control-stock" queda intacto,
  // congelado en su último deploy, en su URL de siempre: no se borra nada.
  //
  // Lo que SÍ es el mismo de antes, a propósito, para no mover datos:
  // database_id (D1) y bucket_name (R2) siguen apuntando exactamente a la
  // misma base y al mismo bucket que ya tenía "control-stock". Sólo cambia
  // la identidad del Worker, no dónde vive la información.
  // Documentación: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stockeate",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-18",
  "compatibility_flags": ["nodejs_compat"],

  // Assets estáticos: el build de Vite (React) se sirve desde el mismo Worker.
  // run_worker_first fuerza que /api/* pase SIEMPRE por el Worker (Hono),
  // y el resto de las rutas caen al SPA (index.html) para el router del front.
  // El Worker corre primero (Hono maneja /api/*) y delega el resto al binding de
  // assets, que sirve el SPA (index.html) para las rutas del router del front.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  // Base de datos D1. Pegá acá el database_id que te devuelve `wrangler d1 create`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "control-stock",
      "database_id": "5b941f72-b258-4530-937f-5f38678b76c7",
      "migrations_dir": "migrations"
    }
  ],

  // Bucket R2 para el backup automático nocturno (ver src/scheduled.ts).
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "control-stock-backups"
    }
  ],

  // Dos crons, ver src/scheduled.ts (usa event.cron para saber cuál disparó):
  //   "0 5 * * *"     una vez por día a las 05:00 UTC (02:00 en Argentina):
  //                   resumen del día anterior + backup a R2.
  //   "*/30 * * * *"  cada media hora: resuelve comprobantes huérfanos de
  //                   facturación electrónica (ver ResultadoHuerfano).
  "triggers": {
    "crons": ["0 5 * * *", "*/30 * * * *"]
  },

  "observability": {
    "enabled": true
  }

  // Secretos que NO van acá. Se cargan con:
  //   wrangler secret put SESSION_SECRET
  //   (CERT_ENC_KEY quedó del modelo viejo de "un certificado por negocio"
  //   y ya no lo usa nada del código — si está cargado en Cloudflare de
  //   antes, se puede borrar con `wrangler secret delete CERT_ENC_KEY`,
  //   pero dejarlo tampoco molesta.)
  //   wrangler secret put ALERTA_DISCORD_WEBHOOK   (opcional — URL del
  //                                       Webhook de un canal de Discord.
  //                                       Sin esto no pasa nada malo: el
  //                                       error 500 se sigue guardando en
  //                                       errores_sistema, sólo que sin
  //                                       aviso en tiempo real. Se crea desde
  //                                       Config. del canal → Integraciones
  //                                       → Webhooks → Nuevo webhook → Copiar
  //                                       URL del webhook.)
  //   wrangler secret put RESEND_API_KEY   (opcional — cuenta en resend.com.
  //                                       Sin esto, el cron diario sigue
  //                                       corriendo el resto de sus tareas
  //                                       —resumen, backup, corte por falta
  //                                       de pago— sólo que no manda el
  //                                       correo de stock bajo/vencimientos.)
  //   wrangler secret put RESEND_FROM      (opcional — "Nombre <correo@tu-
  //                                       dominio>", tiene que ser un
  //                                       dominio verificado en Resend. Si no
  //                                       se carga, usa un default que va a
  //                                       fallar hasta verificar ese dominio.)
}
